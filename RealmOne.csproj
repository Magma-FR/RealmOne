<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\tModLoader.targets" />

	<PropertyGroup>
		<AssemblyName>RealmOne</AssemblyName>
		<TargetFramework>net6.0</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<LangVersion>10</LangVersion>
	</PropertyGroup>

    <PropertyGroup>
        <DotNetPath Condition=" '$(OS)' == 'Windows_NT' ">dotnet.exe</DotNetPath>
        <DotNetPath Condition=" '$(OS)' == 'Unix' ">dotnet</DotNetPath>
        <DotNetPath Condition=" '$(DotNetPath)' == '' ">dotnet</DotNetPath>
    </PropertyGroup>

    <PropertyGroup>
        <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    </PropertyGroup>

    <ItemGroup>
      <AdditionalFiles Remove="Effects\**" />
      <Compile Remove="Effects\**" />
      <EmbeddedResource Remove="Effects\**" />
      <None Remove="Effects\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Buffs\Debuffs\Shocked2.png" />
      <None Remove="Buffs\Debuffs\Shocked3.png" />
      <None Remove="Buffs\Debuffs\Shocked4.png" />
      <None Remove="Buffs\Debuffs\Shocked5.png" />
      <None Remove="Buffs\Debuffs\Shocked6.png" />
      <None Remove="Buffs\Debuffs\Shocked7.png" />
      <None Remove="Buffs\Debuffs\SlowLeaf.png" />
      <None Remove="Buffs\OrchidBonus.png" />
      <None Remove="Common\Core\ParticleContent\Particles\GenericGlowParticle.png" />
      <None Remove="Common\Core\ParticleContent\Particles\SparkleParticle.png" />
      <None Remove="Items\Weapons\PreHM\Forest\ForestVengeance.png" />
      <None Remove="Projectiles\Magic\ForestSpirit.png" />
      <None Remove="Projectiles\Magic\ForestVengeanceProj.png" />
      <None Remove="Projectiles\Magic\ForestVengeanceProjec.png" />
      <None Remove="Projectiles\Magic\LightningBolt.png" />
      <None Remove="Projectiles\Magic\None.png" />
      <None Remove="Projectiles\Magic\OrchidRingRing.png" />
      <None Remove="Projectiles\Magic\TreeBush.png" />
      <None Remove="Projectiles\Magic\TreeBush2.png" />
      <None Remove="Projectiles\Magic\TreeBush3.png" />
    </ItemGroup>

	<ItemGroup>
		<PackageReference Include="tModLoader.CodeAssist" Version="0.1.*" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="StructureHelper">
	    <HintPath>lib\StructureHelper.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Items\Weapons\PreHM\Forest\CursedFort\" />
	</ItemGroup>
</Project>